{
  "id": "core-mobile",
  "name": "Core Mobile",
  "version": "0.2.0",
  "description": "Herramientas que funcionan directamente sobre Android sin Linux adicional.",
  "packages": [],
  "tools": [
    "workspace.list",
    "workspace.search",
    "file.read",
    "file.write",
    "file.patch",
    "file.sha256",
    "archive.zip",
    "archive.unzip",
    "process.exec",
    "process.start",
    "process.logs",
    "process.list",
    "process.stop",
    "checkpoint.create",
    "checkpoint.list",
    "checkpoint.restore",
    "http.get",
    "android.device_info",
    "android.battery",
    "android.clipboard.read",
    "android.clipboard.write"
  ],
  "permissions": [
    "WORKSPACE_READ",
    "WORKSPACE_WRITE",
    "PROCESS_EXECUTE",
    "NETWORK",
    "ANDROID_BRIDGE",
    "CLIPBOARD_READ",
    "CLIPBOARD_WRITE"
  ]
}
