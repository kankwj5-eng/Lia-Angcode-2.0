{
  "id": "github-connector",
  "name": "GitHub Connector",
  "version": "0.2.0",
  "description": "GitHub REST con lectura y escrituras de alto riesgo separadas por permisos.",
  "packages": [],
  "tools": [
    "github.repo",
    "github.issues",
    "github.pulls",
    "github.branches",
    "github.actions",
    "github.branch.create",
    "github.file.put",
    "github.pr.create"
  ],
  "permissions": ["NETWORK", "GITHUB_READ", "GITHUB_WRITE"],
  "runtime": "ANDROID_NATIVE",
  "architectures": [],
  "upstream": {
    "name": "GitHub REST API",
    "license": "N/A",
    "source": "https://docs.github.com/rest"
  }
}
