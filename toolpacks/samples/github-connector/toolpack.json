{
  "id": "github-connector",
  "name": "GitHub Connector",
  "version": "0.2.0",
  "description": "Acceso GitHub de solo lectura con token cifrado por Android Keystore. Escritura se habilita solo cuando sus tools estén implementadas.",
  "packages": [],
  "tools": [
    "github.repo",
    "github.issues",
    "github.pulls",
    "github.branches",
    "github.actions"
  ],
  "permissions": [
    "NETWORK",
    "GITHUB_READ"
  ],
  "runtime": "ANDROID_NATIVE",
  "architectures": [],
  "upstream": {
    "name": "GitHub REST API",
    "license": "N/A",
    "source": "https://docs.github.com/rest"
  }
}
