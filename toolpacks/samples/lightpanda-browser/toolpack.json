{
  "id": "lightpanda-browser",
  "name": "Lightpanda Browser",
  "version": "0.1.0",
  "description": "Navegador headless ligero para agentes, ejecutado como proceso separado dentro de un userland glibc.",
  "packages": [],
  "tools": [
    "browser.goto",
    "browser.markdown",
    "browser.extract",
    "browser.screenshot",
    "browser.click",
    "browser.fill",
    "browser.forms",
    "browser.cookies",
    "browser.console",
    "browser.session.new",
    "browser.session.list",
    "browser.session.close"
  ],
  "permissions": ["NETWORK", "WORKSPACE_WRITE", "PROCESS_EXECUTE"],
  "runtime": "PROOT",
  "architectures": ["aarch64", "x86_64"],
  "upstream": {
    "name": "Lightpanda Browser",
    "license": "AGPL-3.0-only",
    "source": "https://github.com/lightpanda-io/browser"
  }
}
