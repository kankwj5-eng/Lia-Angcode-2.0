{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AngCode Tool Pack",
  "type": "object",
  "required": ["id", "name", "version", "packages", "tools", "permissions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "packages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "runtime": { "type": "string", "enum": ["ANDROID_NATIVE", "PROOT"] },
    "architectures": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "upstream": {
      "type": "object",
      "required": ["name", "license", "source"],
      "properties": {
        "name": { "type": "string" },
        "license": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
